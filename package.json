{
  "name": "site-template",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight open-source Next.js template for SEO tool sites: i18n, MDX blog, technical SEO, AdSense and analytics, no backend required.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cdt2019/site-template.git"
  },
  "keywords": [
    "nextjs",
    "template",
    "seo",
    "tool-site",
    "i18n",
    "mdx",
    "adsense",
    "tailwindcss"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.6",
    "@types/mdx": "^2.0.14",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.1.1"
  }
}
